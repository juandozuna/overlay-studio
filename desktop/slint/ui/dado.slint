// El Dado host panel: a single vertical stepper (Alternative A) that follows the turn top to bottom.
import {ComboBox,TextEdit} from "std-widgets.slint";
export struct DadoView {
    team-name:string,            // "Equipo 1"
    participant-name:string,     // "Ana M." or ""
    participant-pos:string,      // "Participante 1 de 4"
    has-participants:bool,
    can-roll:bool,
    rolling:bool,
    result-name:string,          // "AMARILLO" once landed, else ""
    result-rule:string,
    result-color:color,
    bank-loaded:bool,
    bank-used:string,            // "used 1/8"
    bank-error:string,           // CSV import error text, "" when fine
    books:[string],              // ["All","1 Samuel",...]
    book-index:int,
    question-text:string,        // host copy of the question
    options-on-screen:bool,      // true on yellow
    option-a:string,option-b:string,option-c:string,option-d:string,
    answer-text:string,          // HOST ONLY
    ref-text:string,             // HOST ONLY
    revealed:bool,
    timer-text:string,           // "0:30"
    timer-state:int,             // 0 idle, 1 running, 2 annulled
    score-text:string,           // current team's score
    next-step:int,               // 0 roll, 1 question, 2 timer, 3 reveal, 4 score, 5 next participant
    teams:[string],              // team labels for the setup-mode participants editor
    team-index:int,
    participants-text:string,    // participants of the selected team, one per line (setup mode)
    // added by the panel build (task 3)
    status:string,               // one line above the stepper
    status-kind:int,             // 0 info, 1 warning, 2 error, 3 done
    host-note:string,            // what to tell the participant for the rolled colour
    score-note:string,
    team-color:color,
    has-question:bool,
    bank-exhausted:bool,         // bank loaded but nothing left to draw for the filter
    bank-summary:string,         // "BANK · 8 loaded · 1 used"
    can-next-question:bool,
    can-reveal:bool,
    can-start-timer:bool,
    can-pause:bool,
    timer-paused:bool,
    can-reset-timer:bool,
    timer-seconds:int,
    can-score:bool,
    can-next-participant:bool,
    can-reset-used:bool,
}
component Caption inherits Text {color:#a0a8b5;font-size:11px;min-width:0px;vertical-stretch:0;wrap:word-wrap;}
component Control inherits Rectangle {
    in property <string> label;
    in property <bool> accent;
    in property <bool> enabled:true;
    in property <length> text-size:12px;
    callback invoked();
    min-width:32px;height:30px;border-radius:4px;
    background:accent ? (area.has-hover ? #2d6173 : #24505f) : area.has-hover ? #363b44 : #292d34;
    border-width:accent ? 2px : 1px;border-color:accent ? #53b5d3 : #3c424c;
    opacity:enabled ? 1 : 0.4;
    accessible-role:button;accessible-label:label;
    accessible-action-default => {if root.enabled {root.invoked();}}
    Text {text:root.label;color:root.accent ? #f2f5f9 : #d5dce5;font-size:root.text-size;horizontal-alignment:center;vertical-alignment:center;overflow:elide;}
    area := TouchArea {enabled:root.enabled;clicked=>{root.invoked();}}
}
component Link inherits Rectangle {
    in property <string> label;
    in property <bool> enabled:true;
    callback invoked();
    height:30px;min-width:0px;
    opacity:enabled ? 1 : 0.4;
    accessible-role:button;accessible-label:label;
    accessible-action-default => {if root.enabled {root.invoked();}}
    Text {text:root.label;color:area.has-hover ? #9be0f2 : #64c9e5;font-size:11px;vertical-alignment:center;horizontal-alignment:right;}
    area := TouchArea {enabled:root.enabled;clicked=>{root.invoked();}}
}
component Step inherits Rectangle {
    in property <int> n;
    in property <int> active;
    in property <string> title;
    height:body.preferred-height;
    Rectangle {x:0px;width:16px;
        Rectangle {x:7.5px;y:30px;width:1px;height:max(0px,parent.height - 30px);background:#3c424c;}
        Rectangle {y:7px;width:16px;height:16px;border-radius:8px;
            background:root.n < root.active ? #43b968 : root.n == root.active ? #24505f : #363b44;
            border-width:root.n == root.active ? 1px : 0px;border-color:#53b5d3;
            Text {text:root.n < root.active ? "✓" : root.n;color:root.n < root.active ? #0f2a18 : root.n == root.active ? #f2f5f9 : #a0a8b5;font-size:10px;horizontal-alignment:center;vertical-alignment:center;}
        }
    }
    Rectangle {x:22px;width:parent.width - 22px;border-radius:4px;
        background:root.n == root.active ? #53b5d312 : transparent;
        border-width:1px;border-color:root.n == root.active ? #53b5d361 : transparent;
        body := VerticalLayout {padding:6px;spacing:6px;
            Text {text:root.title;color:root.n == root.active ? #f2f5f9 : #a0a8b5;font-size:11px;vertical-stretch:0;}
            @children
        }
    }
}
export component DadoPanel inherits Rectangle {
    in-out property <DadoView> view;
    in property <bool> setup;
    in-out property <bool> bank-open;
    callback command(string,string); // "roll" "next_question" "skip_question" "start_timer" "pause_timer" "reset_timer" "reveal" "award" "next_participant" "back_participant" "import_bank" "reset_used"
    callback edit(string,string);    // "book" idx, "team" idx, "participants" text
    property <int> active: !view.has-participants ? 1 : view.next-step == 0 ? 2 : view.next-step == 1 || view.next-step == 3 ? 3 : view.next-step == 2 ? 4 : view.next-step == 4 ? 5 : 6;
    property <color> status-color: view.status-kind == 1 ? #ffd54f : view.status-kind == 2 ? #ff8a87 : view.status-kind == 3 ? #7fe3a0 : #a0a8b5;
    property <color> clock-color: view.timer-state == 2 ? #ff6a66 : view.timer-state == 1 && view.timer-seconds <= 5 ? #ff6a66 : view.timer-state == 1 && view.timer-seconds <= 10 ? #ffd54f : #eef2f7;
    height:inner.preferred-height;background:#292d34;border-radius:6px;
    inner := VerticalLayout {padding:12px;spacing:10px;
        Text {text:root.view.status;color:root.status-color;font-size:11px;wrap:word-wrap;min-width:0px;min-height:15px;vertical-stretch:0;}
        // 1 · Up now
        Step {n:1;active:root.active;title:"UP NOW";
            if !root.view.has-participants: Text {text:"No participants yet. Add them in Game setup.";color:#ffd54f;font-size:12px;wrap:word-wrap;min-width:0px;vertical-stretch:0;}
            if root.view.has-participants: HorizontalLayout {height:24px;spacing:6px;
                Rectangle {width:10px;height:10px;border-radius:5px;background:root.view.team-color;y:7px;}
                Text {text:root.view.team-name + (root.view.participant-name == "" ? "" : " · " + root.view.participant-name);color:#f2f5f9;font-size:14px;vertical-alignment:center;overflow:elide;}
            }
            if root.view.has-participants: HorizontalLayout {height:30px;spacing:6px;
                Caption {text:root.view.participant-pos;vertical-alignment:center;}
                Link {width:80px;label:"‹ Back one";invoked=>{root.command("back_participant","");}}
            }
        }
        // 2 · Roll
        Step {n:2;active:root.active;title:"ROLL";
            Control {height:48px;text-size:17px;label:root.view.rolling ? "Rolling…" : root.view.result-name == "" ? "Roll" : "Roll again";accent:root.view.has-participants && root.view.next-step == 0;enabled:root.view.can-roll;invoked=>{root.command("roll","");}}
            if root.view.result-name != "": HorizontalLayout {height:24px;alignment:start;
                Rectangle {width:pill.preferred-width + 18px;border-radius:12px;background:root.view.result-color;border-width:1px;border-color:#ffffff66;
                    pill := HorizontalLayout {padding-left:8px;padding-right:10px;spacing:6px;alignment:center;
                        Rectangle {width:10px;height:10px;border-radius:5px;background:#141620;y:7px;}
                        Text {text:root.view.result-name;color:#141620;font-size:12px;font-weight:600;vertical-alignment:center;}
                    }
                }
            }
            if root.view.result-name == "": Caption {text:"no result yet";}
            if root.view.result-rule != "": Text {text:root.view.result-rule;color:#f2f5f9;font-size:13px;wrap:word-wrap;min-width:0px;vertical-stretch:0;}
            if root.view.host-note != "": Caption {text:root.view.host-note;}
        }
        // 3 · Question
        Step {n:3;active:root.active;title:"QUESTION";
            Control {height:44px;text-size:14px;label:"Next question";accent:root.view.next-step == 1 && root.view.can-next-question;enabled:root.view.can-next-question;invoked=>{root.command("next_question","");}}
            HorizontalLayout {height:30px;spacing:6px;
                ComboBox {min-width:0px;enabled:root.view.bank-loaded;model:root.view.books;current-index <=> root.view.book-index;selected=>{root.edit("book",self.current-index);}}
                Caption {text:root.view.bank-used;vertical-alignment:center;horizontal-alignment:right;wrap:no-wrap;}
            }
            if root.view.has-question: HorizontalLayout {height:30px;
                Link {label:"Skip question";invoked=>{root.command("skip_question","");}}
            }
            if !root.view.bank-loaded: Control {height:30px;label:"Import questions (CSV)…";accent:root.view.next-step == 1;invoked=>{root.command("import_bank","");}}
            if root.view.bank-exhausted: Control {height:30px;label:"Reset used questions";accent:root.view.next-step == 1;invoked=>{root.command("reset_used","");}}
            Rectangle {height:76px;background:#1d2026;border-radius:4px;
                Flickable {x:8px;y:6px;width:parent.width - 16px;height:parent.height - 12px;content-height:qtext.preferred-height;
                    qtext := Text {width:parent.width;text:root.view.question-text == "" ? "Question appears after the roll." : root.view.question-text;color:root.view.question-text == "" ? #a0a8b5 : #d5dce5;font-size:12px;wrap:word-wrap;}
                }
            }
            if root.view.options-on-screen && root.view.has-question: VerticalLayout {spacing:2px;
                Caption {text:root.view.option-a;}
                Caption {text:root.view.option-b;}
                Caption {text:root.view.option-c;}
                Caption {text:root.view.option-d;}
            }
            Rectangle {border-width:1px;border-color:#3c424c;border-radius:4px;height:host.preferred-height;
                host := VerticalLayout {padding:6px;spacing:6px;
                    Text {text:"HOST ONLY — NOT SHOWN ON STREAM";color:#8f98a6;font-size:10px;vertical-stretch:0;}
                    Text {text:root.view.revealed ? "Answer · " + root.view.answer-text : "Answer: ••••••";color:root.view.revealed ? #f2f5f9 : #d5dce5;font-size:12px;wrap:word-wrap;min-width:0px;vertical-stretch:0;}
                    Caption {text:root.view.revealed ? "Ref: " + root.view.ref-text : "Ref: ••••";}
                    Control {height:44px;text-size:14px;label:root.view.revealed ? "Hide" : "Reveal answer";accent:root.view.next-step == 3;enabled:root.view.can-reveal;invoked=>{root.command("reveal","");}}
                }
            }
        }
        // 4 · Timer
        Step {n:4;active:root.active;title:"TIMER · 30 s";
            HorizontalLayout {height:34px;spacing:6px;
                Text {text:root.view.timer-text;color:root.clock-color;font-size:28px;vertical-alignment:center;}
                Rectangle {horizontal-stretch:1;}
                if root.view.timer-state == 2: Rectangle {width:62px;height:20px;y:7px;border-radius:10px;background:#6b1f1d;
                    Text {text:"Annulled";color:#ffb3b0;font-size:11px;horizontal-alignment:center;vertical-alignment:center;}
                }
                if root.view.timer-state == 1: Rectangle {width:56px;height:20px;y:7px;border-radius:10px;background:#363b44;
                    Text {text:"running";color:#d5dce5;font-size:11px;horizontal-alignment:center;vertical-alignment:center;}
                }
                if root.view.timer-state == 0 && root.view.timer-paused: Rectangle {width:52px;height:20px;y:7px;border-radius:10px;background:#363b44;
                    Text {text:"paused";color:#d5dce5;font-size:11px;horizontal-alignment:center;vertical-alignment:center;}
                }
            }
            if root.view.timer-state == 2: Rectangle {height:warn.preferred-height;background:#4a1a19;border-radius:4px;border-width:1px;border-color:#ff6a66;
                warn := VerticalLayout {padding:6px;spacing:2px;
                    Text {text:"⚠ PREGUNTA ANULADA";color:#ffb3b0;font-size:13px;font-weight:700;vertical-stretch:0;}
                    Text {text:"Time is up · question annulled";color:#ffd0ce;font-size:11px;wrap:word-wrap;min-width:0px;vertical-stretch:0;}
                }
            }
            Control {height:44px;text-size:14px;label:"Start 30 s";accent:root.view.next-step == 2;enabled:root.view.can-start-timer;invoked=>{root.command("start_timer","");}}
            HorizontalLayout {height:30px;spacing:6px;
                Control {label:root.view.timer-paused ? "Resume" : "Pause";enabled:root.view.can-pause;invoked=>{root.command("pause_timer","");}}
                Control {label:"Reset";enabled:root.view.can-reset-timer;invoked=>{root.command("reset_timer","");}}
            }
        }
        // 5 · Score
        Step {n:5;active:root.active;title:"SCORE";
            HorizontalLayout {height:28px;spacing:6px;
                Caption {text:root.view.team-name + " · score";vertical-alignment:center;}
                Text {text:root.view.score-text;color:#f2f5f9;font-size:20px;horizontal-alignment:right;vertical-alignment:center;}
            }
            HorizontalLayout {height:44px;spacing:6px;
                Control {width:62px;text-size:14px;label:"−10";enabled:root.view.can-score;invoked=>{root.command("award","-10");}}
                Control {text-size:14px;label:"+10 " + root.view.team-name;accent:root.view.next-step == 4;enabled:root.view.can-score;invoked=>{root.command("award","10");}}
            }
            if root.view.score-note != "": Caption {text:root.view.score-note;}
        }
        // 6 · Next participant
        Step {n:6;active:root.active;title:"NEXT";
            Control {height:44px;text-size:14px;label:"Next participant";accent:root.view.next-step == 5;enabled:root.view.can-next-participant;invoked=>{root.command("next_participant","");}}
        }
        // Bank (collapsed by default)
        Rectangle {height:1px;background:#3c424c;vertical-stretch:0;}
        Rectangle {height:30px;
            accessible-role:button;accessible-label:"Question bank";
            accessible-action-default => {root.bank-open = !root.bank-open;}
            HorizontalLayout {
                Caption {text:root.view.bank-summary;vertical-alignment:center;wrap:no-wrap;}
                Text {text:root.bank-open ? "▾" : "▸";color:#a0a8b5;font-size:11px;horizontal-alignment:right;vertical-alignment:center;}
            }
            TouchArea {clicked=>{root.bank-open = !root.bank-open;}}
        }
        if root.bank-open: Control {height:30px;label:"Import questions (CSV)…";invoked=>{root.command("import_bank","");}}
        if root.bank-open: HorizontalLayout {height:30px;spacing:6px;
            Caption {text:root.view.bank-used;vertical-alignment:center;wrap:no-wrap;}
            Control {width:96px;label:"Reset used";enabled:root.view.can-reset-used;invoked=>{root.command("reset_used","");}}
        }
        if root.view.bank-error != "": Rectangle {height:min(err.preferred-height + 12px,120px);background:#2a1a1a;border-radius:4px;border-width:1px;border-color:#6b1f1d;
            Flickable {x:6px;y:6px;width:parent.width - 12px;height:parent.height - 12px;content-height:err.preferred-height;
                err := Text {width:parent.width;text:root.view.bank-error;color:#ff8a87;font-size:11px;wrap:word-wrap;}
            }
        }
        if root.bank-open: Caption {text:"UTF-8 CSV with the header: book, reference, question, A, B, C, D, correct. Use quotes around text with commas. Stored inside the project.";}
        // Game setup: who plays for each team
        if root.setup: Caption {text:"PARTICIPANTS · one name per line, in turn order";}
        if root.setup: HorizontalLayout {height:30px;spacing:6px;
            Caption {text:"Team";width:60px;vertical-alignment:center;}
            ComboBox {min-width:0px;model:root.view.teams;current-index <=> root.view.team-index;selected=>{root.edit("team",self.current-index);}}
        }
        if root.setup: Rectangle {height:110px;background:#1d2026;border-radius:4px;
            TextEdit {x:4px;y:4px;width:parent.width - 8px;height:parent.height - 8px;text <=> root.view.participants-text;wrap:word-wrap;edited(text)=>{root.edit("participants",text);}}
        }
    }
}
